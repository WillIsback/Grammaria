{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "La page embarquée (tauri://localhost) peut appeler les commandes de l'application, une par une, et rien d'autre : ni les commandes de Tauri (core:default), ni celles des plugins, ni aucune origine distante.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-update-status",
    "allow-update-check",
    "allow-update-install",
    "allow-update-open-release-page",
    "allow-db-read",
    "allow-db-read-many",
    "allow-db-batch",
    "allow-settings-get",
    "allow-settings-set",
    "allow-valid-words-get",
    "allow-valid-words-add",
    "allow-llm-models",
    "allow-llm-chat",
    "allow-llm-cancel",
    "allow-log-page"
  ]
}
