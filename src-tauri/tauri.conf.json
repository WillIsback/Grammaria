{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grammaria",
  "mainBinaryName": "grammaria",
  "version": "../package.json",
  "identifier": "fr.willisback.grammaria",
  "build": {
    "beforeBuildCommand": "npm run build && bun scripts/desktop/prepare-sidecar.ts",
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grammaria",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "publisher": "Grammaria",
    "category": "Productivity",
    "shortDescription": "Correcteur de français qui suit vos fautes récurrentes",
    "longDescription": "Grammaria corrige vos textes avec le modèle de langage de votre choix, classe les fautes avec les règles françaises de LanguageTool et suit votre progression.",
    "copyright": "GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/grammaria-server"],
    "resources": {
      "resources/dist/": "dist/",
      "resources/lt/": "lt/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
