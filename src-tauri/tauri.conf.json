{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grammaria",
  "mainBinaryName": "grammaria",
  "version": "../package.json",
  "identifier": "fr.willisback.grammaria",
  "build": {
    "beforeBuildCommand": "npm run build:bureau",
    "frontendDist": "../dist/bureau"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Grammaria",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "worker-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBN0FGQzkzRjlFRjE2QkEKUldTNkZ1LzVrL3g2dXRrZnJMWHJOdERtalNOSXRuWTJ1bEY2ZGJUQWo4SFpTZzFhYjhOWGcvY0gK",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/WillIsback/Grammaria/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "publisher": "Grammaria",
    "category": "Productivity",
    "shortDescription": "Correcteur de français qui suit vos fautes récurrentes",
    "longDescription": "Grammaria corrige vos textes avec le modèle de langage de votre choix, classe les fautes avec les règles françaises de LanguageTool et suit votre progression.",
    "copyright": "GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "resources": {
      "../moteur/data/lt/": "moteur/lt/",
      "../moteur/data/grammaria/": "moteur/grammaria/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
